datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")   
}

generator client {
  provider = "prisma-client-js"
}

model Logbook {
  id         Int      @id @default(autoincrement())
  name       String
  nik        String
  department String
  remarks    String?
  photoUrl   String
  timestamp  DateTime @default(now())
}
